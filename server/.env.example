PORT=4000
# Bind address (loopback by default; set 0.0.0.0 only if you accept LAN access to an unauthenticated API)
HOST=localhost
# Comma-separated browser origins allowed by CORS (the dev client)
CORS_ORIGIN=http://localhost:3000
# App connection: non-owner role (created by migration 002)
# Run `scripts/dev-db.sh url` to print the exact URLs for your private dev cluster.
DATABASE_URL=postgresql://app_user@/schedule_dev?host=/path/to/pgdata/schedule-app/sock&port=5433
# Migration connection: owner role
MIGRATION_DATABASE_URL=postgresql://postgres@/schedule_dev?host=/path/to/pgdata/schedule-app/sock&port=5433
CURRENT_USER_ID=00000000-0000-4000-8000-000000000001
USER_TIMEZONE=UTC
